                    <div class="content-box">
                        <div class="container-fluid">
                            <div class="blog-title-title">
                                <h2>@Model.Title</h2>
                            </div>
                            <div class="blog-content-meta-detail">
                                <div class="row gy-4 justify-content-center">
                                    <div class="col-lg-3 col-sm-6">
                                        <div class="blog-content-meta-detail-item">
                                            <i class="bi bi-stack"></i>
                                            <h6>دسته بندی: </h6>
                                            <a href="" class="badge bg-danger font-14">@Model.BlogCategory</a>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-6">
                                        <div class="blog-content-meta-detail-item">
                                            <i class="bi bi-clock"></i>
                                            <h6>زمان مطالعه: </h6>
                                            <span>3 دقیقه</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-sm-6">
                                        <div class="blog-content-meta-detail-item">
                                            <i class="bi bi-calendar-check"></i>
                                            <h6>آخرین بروزرسانی: </h6>
                                            <span>@Model.LastUpdateDate</span>
                                        </div>
                                    </div>
                                   
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="blog-content mt-3">
                    <div class="content-box">
                        <div class="container-fluid">
                            <div class="blog-single-content">
                                <div class="text-center mb-4">
                                    <img "
                                         src="@(!string.IsNullOrEmpty(Model.Image) ? PathExtension.ArticleOrigin + Model.Image : PathExtension.DefaultAvatar)" title="@Model.Title" class="img-thumbnail" alt="">
                                </div>
                                <div class="product-desc-content">
                                    <input class="read-more-state" id="readMore2" type="checkbox">
                                    <!-- والد بیشتر ، کمتر ، تمام متن توضیحات باید داخل این تگ قرار بگیرند -->
                                    <div class="read-more-wrap">
                                        <h6 class="font-26 mb-2 title-font title-line-bottom">
                                           @Model.ShortDescription
                                        </h6>
                                        <p>
                                           @Model.Description
                                        </p>
                                        <!-- متن بیشتر -->
                                       
                                        <!-- پایان متن بیشتر -->
                                    </div>
                                    <!-- پایان والد بیشتر کمتر -->
                                    @* <label class="read-more-trigger" for="readMore2"></label> *@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
